{
  "name": "@mockforge/forgeconnect",
  "version": "0.1.0",
  "description": "MockForge ForgeConnect - Browser SDK for intercepting requests and creating mocks from the browser",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SaaSy-Solutions/mockforge.git",
    "directory": "sdk/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run typecheck && rollup --config rollup.config.mjs",
    "dev": "rollup --config rollup.config.mjs --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node tests/runtime.cjs",
    "audit": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "mock",
    "testing",
    "api",
    "http",
    "browser",
    "intercept",
    "forgeconnect"
  ],
  "author": "MockForge Contributors",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^22.0.0",
    "jsdom": "^23.0.0",
    "rollup": "^4.9.0",
    "typescript": "^5.0.0",
    "tslib": "^2.8.1",
    "whatwg-fetch": "^3.6.20",
    "fake-indexeddb": "^6.0.0",
    "vitest": "^5.0.5",
    "vite": "^8.3.4",
    "@vitest/coverage-v8": "^5.0.5"
  },
  "dependencies": {}
}
