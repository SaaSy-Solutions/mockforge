{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.saasy-solutions/mockforge",
  "description": "Local MCP tools for inspecting and validating OpenAPI and Swagger specifications.",
  "version": "0.3.241",
  "repository": {
    "url": "https://github.com/SaaSy-Solutions/mockforge",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "mockforge-cli",
      "version": "0.3.241",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
